<service>
  <id>cms-middle-backend</id>
  <name>CMS Middle Backend</name>
  <description>CMS Middle Express, Socket.IO, MQTT and camera backend</description>

  <executable>%BASE%\runtime\node.exe</executable>
  <arguments>"%BASE%\app\cms-middle-be\index.js"</arguments>
  <workingdirectory>%BASE%\app\cms-middle-be</workingdirectory>

  <env name="NODE_ENV" value="production"/>
  <env name="USER_DATA_PATH" value="%ProgramData%\CMS-Middle"/>
  <env name="FFMPEG_PATH" value="%BASE%\app\cms-middle-be\node_modules\@ffmpeg-installer\win32-x64\ffmpeg.exe"/>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>Tcpip</depend>

  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="15 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>60 sec</stoptimeout>

  <logpath>%ProgramData%\CMS-Middle\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
